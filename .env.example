# Stratos AI — Variables de entorno
# Copia este archivo como .env.local y llena los valores reales.
# NUNCA subas .env.local a Git.

# URL del subdominio de la aplicación (donde vive el CRM, ERP, etc.)
VITE_APP_URL=https://app.stratoscapitalgroup.com

# Supabase (cuando migres de localStorage a BD real)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Identificadores PÚBLICOS del alta integrada de WhatsApp. No poner aquí el
# App Secret de Meta ni el API Key de Infobip: esos viven como secretos de las
# Edge Functions, nunca en Vite ni en Git.
VITE_META_APP_ID=your_meta_app_id_here
VITE_META_CONFIG_ID=your_meta_embedded_signup_config_id_here
VITE_INFOBIP_SOLUTION_ID=your_infobip_partner_solution_id_here

# Telegram bot username (sin la @). Lo da BotFather al crear el bot.
# Si no lo seteas, el botón "Conectar Telegram" muestra el flujo manual (/conectar CODE).
VITE_TELEGRAM_BOT_USERNAME=stratos_crm_bot
