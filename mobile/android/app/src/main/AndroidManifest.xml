<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!--
          QUE UNA LLAMADA ABRA LA APP ENCIMA DE TODO, con la app cerrada.

          Este servicio reemplaza al que traia el complemento de avisos. Todo lo
          que NO sea una llamada lo delega en el de siempre: un error aca dejaria
          sin avisos a todo el equipo, no solo sin llamadas.

          El de origen se desactiva a proposito. Si quedaran los dos declarados,
          Android elige uno solo y no hay forma de saber cual — y la mitad de las
          veces elegiria el equivocado.
        -->
        <service
            android:name=".ServicioLlamadas"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Notas de voz del chat de WhatsApp (getUserMedia dentro del WebView):
         Capacitor concede el permiso al WebView SOLO si la app lo declara y el
         usuario lo acepta en el diálogo nativo. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ⭐ SIN ESTO EL DICTADO NO EXISTE PARA ANDROID.
         Desde Android 11 (API 30) una app solo "ve" los paquetes que declara.
         SpeechRecognizer.isRecognitionAvailable() consulta por dentro los
         servicios que responden a android.speech.RecognitionService, y si no
         están declarados acá la consulta vuelve VACÍA: el sistema responde
         "no hay dictado" aunque el teléfono lo tenga.
         Sintoma exacto en la app (Angel, 25-ago-2026, Android real):
           "El dictado del telefono no arranco - el-telefono-dice-que-no-esta-disponible"
         El plugin no lo declara en su propio manifest, asi que va aca. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Adjuntar fotos desde la cámara en el chat / futuros módulos. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Notificaciones (Android 13+ exige pedirlo en runtime): avisos de
         WhatsApp del CRM vía el plugin LocalNotifications. El CRM pide el
         permiso al entrar (src/lib/native.js → ensureNotifPermission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Que el aviso suene A LA HORA, con la app cerrada.

      Un recordatorio de "en dos minutos" que llega veinte minutos tarde no es
      un recordatorio. Android agrupa las alarmas para ahorrar bateria salvo
      que se pida lo contrario, y desde Android 12 eso hay que declararlo.

      Se usa SCHEDULE_EXACT_ALARM y NO el mas comodo USE_EXACT_ALARM: el
      segundo se concede solo, pero Google Play lo reserva para apps de alarma
      y calendario, y pedirlo aca seria un motivo de rechazo el dia que la app
      entre a la tienda.
    -->
    <!--
      Abrir una pantalla completa cuando entra una llamada, sin que la persona
      tenga que tocar nada. Es lo que hace WhatsApp.

      Desde Android 14 esto solo se concede solo a las apps de llamadas y
      alarmas; al resto hay que pedirselo a la persona. Si no esta concedido
      Android NO falla: muestra un cartel grande con sonido. Peor que la
      pantalla completa, mucho mejor que una tira.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Sin esto, apagar y prender el telefono borra todos los recordatorios
         que el usuario ya tenia agendados. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
