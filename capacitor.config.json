{
  "appId": "com.stratoscapitalgroup.app",
  "appName": "Stratos AI",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#060A11",
    "preferredContentMode": "mobile",
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#060A11",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "Keyboard": {
      "resize": "native",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#060A11",
      "overlaysWebView": false
    }
  }
}
